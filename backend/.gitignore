# Python
__pycache__/
*.py[cod]

# 环境
.env

# uv
# (uv.lock 入库;虚拟环境不入)
.venv/

# 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# RAG 持久化(ingest 重建,不入库)
.rag_store/

# 语义记忆持久化(chroma,运行时产物;治理清除即重建,不入库)
.mem_store/

# 日志(运行时产物)
logs/

# 冷层 SQLite(运行时产物,不入库;data/rag_seeds.jsonl 仍入库)
data/*.db

# fillers 预生成语音(运行时产物,重生成=删目录跑 -m app.voice.fillers)
data/fillers/
