# 模型配置
LLM_PROVIDER=deepseek
# base_url (OpenAI)：https://api.deepseek.com | base_url (Anthropic)：https://api.deepseek.com/anthropic
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-你的真实key
# model：deepseek-v4-flash、deepseek-v4-pro、deepseek-v4-flash-vision-exp
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：本地备选 provider（默认注释掉）
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b

# 服务配置
REDIS_URL=redis://localhost:6379/0
# =1 时控制台日志升 DEBUG(verbose);默认 INFO
# HRP_VERBOSE=1

# 模型缓存(强烈建议指向 ASCII 盘符路径:默认缓存落在 C:\Users\<用户名>\.cache\,
# 中文用户名会让 sentencepiece 等库直接打不开文件——SenseVoice 曾因此 NOT_FOUND;
# 且模型数 GB,别塞系统盘。进程级生效:写入本文件或起服务前终端 set/export 均可,
# 不污染系统;已设同名系统变量时以系统变量优先(dotenv 默认不覆盖))
# HF_HOME=D:/MetaverseStudy/hf_cache            # bge 系列(RAG)
# MODELSCOPE_CACHE=D:/MetaverseStudy/modelscope_cache  # SenseVoice(ASR)

# 语音(CosyVoice sidecar;正常由主进程启动时自动拉起,退出时按本开关有序关停)
# TTS_SIDECAR_PORT=9880
# TTS_SIDECAR_PYTHON=../models/voices/CosyVoice/.venv/Scripts/python.exe
# --reload 热载开发设 0:免得改一行代码陪杀 sidecar(模型重载分钟级)
# TTS_SIDECAR_KILL_ON_EXIT=1

# 危机闸门(severity ≥ 阈值判危机;词典内容运行时补)
CRISIS_GATE_THRESHOLD=0.7

# 治理/模型配置存储:POST /admin/config 存 api_key 时的 AES-GCM 加密密钥
# (hex,16/24/32 字节;不设则该端点拒存 api_key,其余配置可存)。
# 生成一段:python -c "import os; print(os.urandom(32).hex())"
# HRP_CONFIG_AES_KEY=

# 浏览器跨源白名单(station/admin REST;逗号分隔。默认=前端 dev 两址,生产同源可收紧)
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
