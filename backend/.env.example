# 模型配置
LLM_PROVIDER=deepseek
# base_url (OpenAI)：https://api.deepseek.com | base_url (Anthropic)：https://api.deepseek.com/anthropic
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# model：deepseek-flash
DEEPSEEK_MODEL=deepseek-flash

# 可选：本地备选 provider（默认注释掉）
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b

# 服务配置
REDIS_URL=redis://localhost:6379/0
# =1 时控制台日志升 DEBUG(verbose);默认 INFO
# HRP_VERBOSE=1
# 文件日志目录(默认 logs;测试/CI 可重定向到临时目录,e2e 的日志断言同源读取)
# HRP_LOG_DIR=logs

# 模型缓存(强烈建议指向 ASCII 盘符路径:默认缓存落在 C:\Users\<用户名>\.cache\,
# 中文用户名会让 sentencepiece 等库直接打不开文件——SenseVoice 曾因此 NOT_FOUND;
# 且模型数 GB,别塞系统盘。进程级生效:写入本文件或起服务前终端 set/export 均可,
# 不污染系统;已设同名系统变量时以系统变量优先(dotenv 默认不覆盖))
# HF_HOME=D:/MetaverseStudy/hf_cache            # bge 系列(RAG)
# MODELSCOPE_CACHE=D:/MetaverseStudy/modelscope_cache  # SenseVoice(ASR)

# 语音 TTS(运行模式二选一,由 TTS_MODE 切换)
# remote = HTTP 远程服务(默认):GPT-SoVITS/CosyVoice 等远程 TTS Service(启动见 docs/guides/)
# local  = CosyVoice sidecar 子进程(回滚用;正常由主进程启动时自动拉起,退出时按本开关有序关停)
# TTS_MODE=remote
# 远程服务地址;必须写 127.0.0.1 不写 localhost(IPv6 ::1 先解析会白等 2.1s)
# TTS_SERVICE_URL=http://127.0.0.1:9001
# TTS_SERVICE_TIMEOUT_S=600
# local 模式以下三项生效:
# TTS_SIDECAR_PORT=9880
# TTS_SIDECAR_PYTHON=../models/voices/CosyVoice/.venv/Scripts/python.exe
# --reload 热载开发设 0:免得改一行代码陪杀 sidecar(模型重载分钟级)
# TTS_SIDECAR_KILL_ON_EXIT=1

# ── GPT-SoVITS tts_service 进程编排(remote 模式下的默认路径) ──
# backend 启动时自己拉起 `python -m tts_service` 子进程,不用另开终端。
# 两个进程两个 venv:torch 2.6.0+cu124(TTS)vs 2.12.1+cu126(backend),
# 装不到一起,所以只能子进程。各自独立 CUDA context,显存互不干扰。
#
# 1 = 由 backend 拉起(默认);0 = 只连不拉(你自己在别的终端起了 TTS 时用)
# TTS_SERVICE_SPAWN=1
# GPT-SoVITS venv 里的 python;路径不对就只会打 WARN 跳过拉起
# TTS_SERVICE_PYTHON=../GPT-SoVITS/.venv/Scripts/python.exe
# 子进程工作目录 —— 硬需求,别改:
#   GPT_SoVITS/sv.py 用 os.getcwd() 找 eres2net,tts_infer.yaml 权重路径也是相对的
# TTS_SERVICE_CWD=../GPT-SoVITS
# 清掉 CONDA_PREFIX/PYTHON* 并把 GPT-SoVITS venv 的 Scripts 前置到子进程 PATH
# TTS_SERVICE_SCRUB_ENV=1
# Windows:CREATE_NEW_PROCESS_GROUP|CREATE_NO_WINDOW(不弹黑框 + 关停能杀整棵树)
# TTS_SERVICE_PROCESS_GROUP=1
# --reload 热载开发设 0:否则每重载一次就拉起一个模型进程
# TTS_SERVICE_KILL_ON_EXIT=1
# 子进程 stdout/stderr 落盘位置(相对 GPT-SoVITS 目录)。
# tts_service 自己的 logger 已经有 GPT-SoVITS/logs/tts_service_*.log,
# 但上游 print(Loading ... weights)和第三方 warning、traceback
# 不走 loguru,只在进程输出流里 —— 排错要看的是这个文件。
# TTS_SERVICE_STDOUT_LOG=logs/tts_service_stdout.log
# 1=子进程输出同时打到 backend 终端(默认 0,只落文件);调试时开 1
# TTS_SERVICE_STDOUT_TO_CONSOLE=0
# 单文件上限(字节)与保留份数,超限按 .1 .2 .3 轮转
# TTS_SERVICE_STDOUT_MAX_BYTES=10485760
# TTS_SERVICE_STDOUT_BACKUP_COUNT=3
# 子进程 stdio 编码,同时也是父进程读日志的解码编码(两边必须一致)。
# 不定死的话子进程跟本机 ANSI 代码页走(cp936 → gbk),中文与符号会全解成 U+FFFD
# TTS_SERVICE_PYTHONIOENCODING=utf-8

# 远程服务共享认证 token(Bearer header);空=跳过验证(开发环境)
# SERVICE_AUTH_TOKEN=

# 危机闸门(severity ≥ 阈值判危机;词典内容运行时补)
CRISIS_GATE_THRESHOLD=0.7

# 治理/模型配置存储:模型配置(/admin/llm/* profiles)存 api_key 时的 AES-GCM 加密密钥
# (hex,16/24/32 字节;不设则自举生成 backend/.hrp_config_key,凭证不入库)。
# 生成一段:python -c "import os; print(os.urandom(32).hex())"
# HRP_CONFIG_AES_KEY=

# 浏览器跨源白名单(station/admin REST;逗号分隔。默认=前端 dev 两址,生产同源可收紧)
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
